{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/minimax-m2.5-free",
  "provider": {
    "opencode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode (MiniMax Free)",
      "options": {
      "baseURL": "https://opencode.ai/zen/v1"
      }
    }
  },
  "mcp": {
    "pencil": {
      "command": [
        "/tmp/.mount_pencilujP2xY/resources/app.asar.unpacked/out/mcp-server-linux-x64",
        "--app",
        "desktop"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "plugin": [
    "opencode-mem",
    "cc-safety-net",
    "envsitter-guard"
  ]
}
