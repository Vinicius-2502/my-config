{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "",
    "color": {
      "1": "blue",
      "2": "white",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": "",
    },
    "width": null,
    "height": null,
    "padding": {
      "top": 0,
      "left": 0,
      "bottom": 0,
      "right": 4,
    },
    "printRemaining": true,
    "preserveAspectRatio": true,
    "recache": false,
    "position": "left",
    "chafa": {
      "fgOnly": false,
      "symbols": "block+border+space-wide-inverted",
    },
  },
  "display": {
    "stat": false,
    "pipe": false,
    "showErrors": false,
    "disableLinewrap": false,
    "hideCursor": false,
    "separator": "",
    // "separator": "        ",
    "color": {
      "keys": "",
      "title": "blue",
      "output": "blink_",
      "separator": "",
    },
    "brightColor": true,
    "duration": {
      "abbreviation": false,
      "spaceBeforeUnit": "default",
    },
    "size": {
      "maxPrefix": "YB",
      "binaryPrefix": "iec",
      "ndigits": 2,
      "spaceBeforeUnit": "default",
    },
    "temp": {
      "unit": "D",
      "ndigits": 1,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91",
      },
      "spaceBeforeUnit": "default",
    },
    "percent": {
      "type": ["num", "num-color"],
      "ndigits": 0,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91",
      },
      "spaceBeforeUnit": "default",
      "width": 0,
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "-",
      },
      "border": {
        "left": "[ ",
        "right": " ]",
        "leftElapsed": "",
        "rightElapsed": "",
      },
      "color": {
        "elapsed": "auto",
        "total": "97",
        "border": "97",
      },
      "width": 10,
    },
    "fraction": {
      "ndigits": 2,
      "trailingZeros": "default",
    },
    "noBuffer": false,
    "key": {
      "width": 20,
      "type": "both",
      "paddingLeft": 0,
    },
    "freq": {
      "ndigits": 2,
      "spaceBeforeUnit": "default",
    },
    "constants": [],
  },
  "general": {
    "thread": true,
    "processingTimeout": 5000,
    "detectVersion": true,
    "playerName": "",
    "dsForceDrm": false,
  },
  "modules": [
    // TITLE
    {
      "type": "title",
      "key": " ",
      "keyIcon": "",
      "fqdn": false,
      "format": "{user-name-colored}@{host-name-colored}💻",
      "color": {
        "user": "cyan",
        "at": "",
        "host": "cyan",
      },
    },

    {
      "type": "custom",
      "format": "╭────────────────────────────────────────────────────────────────────────╮",
      "outputColor": "cyan",
    },

    // SYSTEM
    {
      "type": "custom",
      "format": "│                                 SYSTEM                                 │",
      "outputColor": "cyan",
    },

    {
      "type": "os",
      "keyIcon": "│ ",
      "keyColor": "cyan",
      "format": "{pretty-name<54}{#cyan}│",
    },

    {
      "type": "host",
      "keyIcon": "│ 󰌢",
      "keyColor": "cyan",
      "format": "{name<54}{#cyan}│",
    },

    {
      "type": "kernel",
      "keyIcon": "│ ",
      "keyColor": "cyan",
      "format": "{sysname} {arch<48}{#cyan}│",
    },

    {
      "type": "bios",
      "keyIcon": "│ 󰌢",
      "keyColor": "cyan",
      "format": "{version} {type<47}{#cyan}│",
      // "format": "{release<54}{#cyan}│",
    },

    {
      "type": "custom",
      "format": "├────────────────────────────────────────────────────────────────────────┤",
      "outputColor": "cyan",
    },

    //ENVIRONMENT
    {
      "type": "custom",
      "format": "│                              ENVIRONMENT                               │",
      "outputColor": "cyan",
    },

    {
      "type": "sound",
      "keyIcon": "│ 󰌢",
      "keyColor": "cyan",
      "format": "{name} -> {volume-percentage<22}{#cyan}│",
    },

    {
      "type": "packages",
      "keyIcon": "│ 󰏖",
      "keyColor": "cyan",
      "disabled": ["winget"],
      "combined": false,
      "format": "{dpkg} (dpkg), {flatpak-all} (flatpak-user)                        {#cyan}│",
    },

    {
      "type": "shell",
      "keyIcon": "│ ",
      "keyColor": "cyan",
      "format": "{exe-name} {version<49}{#cyan}│",
    },

    {
      "type": "de",
      "keyIcon": "│ ",
      "keyColor": "cyan",
      "format": "{pretty-name} {version<47}{#cyan}│",
    },

    {
      "type": "terminal",
      "keyIcon": "│ ",
      "keyColor": "cyan",
      "format": "{pretty-name<54}{#cyan}│",
    },

    {
      "type": "custom",
      "format": "├────────────────────────────────────────────────────────────────────────┤",
      "outputColor": "cyan",
    },

    // HARDWARE

    {
      "type": "custom",
      "format": "│                                HARDWARE                                │",
      "outputColor": "cyan",
    },

    {
      "type": "cpu",
      "keyIcon": "│ ",
      "keyColor": "cyan",
      "format": "{name<54}{#cyan}│",
      "temp": false,
      "showPeCoreCount": true,
      "tempSensor": "",
    },

    // MEMORY (DESABILITADO POR BUG COM COMPUTADORES COM MAIS DE UMA PLACA DE VIDEO)
    // {
    //   "type": "gpu",
    //   "keyIcon": "│ 󰾲",
    //   "keyColor": "cyan",
    //   "format": "{vendor} {name} -> {type<30}{#cyan}│",
    //   "driverSpecific": false,
    //   "detectionMethod": "pci",
    //   "temp": false,
    //   "hideType": "none",
    //   "percent": {
    //     "green": 50,
    //     "yellow": 80,
    //     "type": 0,
    //   },
    // },

    {
      "type": "memory",
      "keyIcon": "│ ",
      "keyColor": "cyan",
      "format": "{used} / {total} -> {percentage<34}{#cyan}│",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0,
      },
    },

    {
      "type": "swap",
      "keyIcon": "│ 󰓡",
      "keyColor": "cyan",
      "format": "{used} / {total} -> {percentage<33}{#cyan}│",
      "separate": false,
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0,
      },
    },

    {
      "type": "disk",
      "keyIcon": "│ ",
      "keyColor": "cyan",
      "format": "{size-used} / {size-total} -> {size-percentage} {filesystem<23}{#cyan}│",
      "showRegular": true,
      "showExternal": true,
      "showHidden": false,
      "showSubvolumes": false,
      "showReadOnly": true,
      "showUnknown": false,
      "folders": "",
      "hideFolders": "/efi:/boot:/boot/*",
      "hideFS": "",
      "useAvailable": false,
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0,
      },
    },
    {
      "type": "custom",
      "format": "├────────────────────────────────────────────────────────────────────────┤",
      "outputColor": "cyan",
    },

    // COLORS

    {
      "type": "custom",
      "format": "│                                 COLORS                                 │",
      "outputColor": "cyan",
    },

    {
      "type": "custom",
      "format": "│  colors         {#black}★{#} {#red}★{#} {#green}★{#} {#yellow}★{#} {#blue}★{#} {#magenta}★{#} {#cyan}★{#} {#white}★{#} {#bright_black}★{#} {#bright_red}★{#} {#bright_green}★{#} {#bright_yellow}★{#} {#bright_blue}★{#} {#bright_magenta}★{#} {#bright_cyan}★{#} {#bright_white}★{#}                       {#cyan}│{#}",
    },

    // {
    //   "type": "colors",
    //   "keyColor": "cyan",
    //   // "format": "{pretty-name<54}{#cyan}│",
    //   "key": "colors",
    //   "keyIcon": "│ ",
    //   "symbol": "star",
    //   "paddingLeft": 3,
    //   "block": {
    //     "width": 5,
    //     "range": [0, 15],
    //   },
    //   "brightness": "light",
    // },

    {
      "type": "custom",
      "format": "│                                                                        │",
      "outputColor": "cyan",
    },

    {
      "type": "custom",
      "format": "╰────────────────────────────────────────────────────────────────────────╯",
      "outputColor": "cyan",
    },
  ],
}
